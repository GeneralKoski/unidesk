# Copia in `.env`. Il file `.env` è in .gitignore: non viene mai committato.

# --- Sessione (OBBLIGATORIO) ---
# Chiave per cifrare il cookie di sessione. >= 32 caratteri, casuale.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Base URL (opzionali, default Unipr) ---
# Gli utenti si autenticano via login: qui NON servono credenziali.
ESSE3_BASE=https://unipr.esse3.cineca.it/e3rest/api

# Unipr tiene un'istanza Moodle per ogni anno accademico e le iscrizioni non
# migrano: i corsi degli esami arretrati restano sull'istanza del loro anno.
# Elenca qui tutte le istanze da leggere, separate da virgola, la corrente per
# prima. Se ometti la variabile vengono usati anno corrente e precedente,
# calcolati dalla data.
ELLY_BASES=https://elly2026.didattica.unipr.it,https://elly2025.didattica.unipr.it
